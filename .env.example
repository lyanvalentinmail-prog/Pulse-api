# Copiá este archivo a .env (local) o cargá estas variables en Render/Vercel.
# NUNCA subas las claves al repo: secrets.local.json y .env están en .gitignore.

# IA → /ia/gemini (Google AI Studio). Sin clave el endpoint responde 503.
GEMINI_API_KEY=
# Modelo por defecto si no se pasa ?model=
GEMINI_MODEL=gemini-2.0-flash

# IA → /ia/image (texto → imagen). No usa claves: genera con Perchance y, si
# falla, intenta Pollinations (el respaldo también puede fallar). Todo es opcional.
# Proveedor por defecto: auto | perchance | pollinations
IMAGE_PROVIDER=auto
# Código de anuncios opcional; no evita necesariamente Cloudflare/Turnstile: uno fresco
# de 64 caracteres hex sacado del navegador (pestaña Red de perchance.org/apigen).
PERCHANCE_AD_CODE=
# Canal del generador y hash del cliente (cambian poco; dejar vacío = el default).
PERCHANCE_CHANNEL=
PERCHANCE_CLIENT_VERSION=

# Descargas de YouTube → instancia propia de cobalt (opcional pero recomendado).
# https://github.com/imputnet/cobalt
COBALT_API_URL=

# Portada (/welcome): video y póster remotos (opcional)
WELCOME_VIDEO_URL=
WELCOME_POSTER_URL=
